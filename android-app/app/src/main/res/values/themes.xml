<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MinhasFinancasRenova" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@color/renova_navy</item>
        <item name="android:navigationBarColor">@color/renova_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/renova_navy</item>
        <item name="colorAccent">@color/renova_cyan</item>
    </style>

    <style name="Theme.MinhasFinancasRenova.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/renova_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.MinhasFinancasRenova</item>
    </style>
</resources>
